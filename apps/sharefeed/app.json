{
  "id": "sharefeed",
  "name": "ShareFeed",
  "version": "1.0.1",
  "publisher": "UniqueDroid",
  "description": {
    "de": "Minimalistischer RSS- & News-Reader für unterwegs mit Offline-Cache und ShareOS.fs Speicherung.",
    "en": "Minimalist mobile RSS & news reader with offline caching and ShareOS.fs storage."
  },
  "type": "webapp",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "news",
  "license": "GPL-2.0-only",
  "internet": true,
  "min_shareos": "0.2.0-beta.1",
  "permissions": ["files"],
  "window": {
    "width": 1040,
    "height": 700
  },
  "opens": [
    {
      "ext": [".opml", ".xml", ".json"],
      "mode": "view",
      "label": {
        "de": "In ShareFeed importieren",
        "en": "Import into ShareFeed"
      }
    }
  ]
}
