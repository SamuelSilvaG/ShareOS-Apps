{
  "id": "sharesnippets",
  "name": "ShareSnippets",
  "version": "1.0.0",
  "publisher": "UniqueDroid",
  "description": {
    "de": "Code- & Textbaustein-Manager für Befehle, Konfigurationen und Vorlagen mit ShareOS.fs Speicherung.",
    "en": "Code & text snippet manager for commands, configs and templates with ShareOS.fs storage."
  },
  "type": "webapp",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "development",
  "license": "GPL-2.0-only",
  "min_shareos": "0.2.0-beta.1",
  "permissions": ["files"],
  "window": {
    "width": 1040,
    "height": 720
  },
  "opens": [
    {
      "ext": [".json", ".sh", ".yml", ".yaml", ".conf"],
      "mode": "edit",
      "label": {
        "de": "In ShareSnippets öffnen",
        "en": "Open in ShareSnippets"
      }
    }
  ]
}
